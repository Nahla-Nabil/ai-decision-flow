# Copy to .env.local and fill in. .env.local is git-ignored.

# --- LLM (any OpenAI-compatible provider) -----------------------------------
# Groq (free tier): key from https://console.groq.com/keys
# Groq retires models over time. List what your key can use with:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $LLM_API_KEY"
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_api_key
LLM_MODEL=openai/gpt-oss-20b
# OpenAI:      LLM_BASE_URL=https://api.openai.com/v1      LLM_MODEL=gpt-4o-mini
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=openrouter/free
# Ollama:      LLM_BASE_URL=http://localhost:11434/v1      LLM_API_KEY=ollama  LLM_MODEL=llama3.2

LLM_TIMEOUT_SECONDS=30
# Reasoning models (gpt-oss, o-series…) think before answering, and the thinking
# counts against this cap: too small and the reply comes back empty.
LLM_MAX_TOKENS=512
# Only for reasoning models (leave commented for others): low | medium | high.
# "low" keeps a one-word YES/NO answer fast.
LLM_REASONING_EFFORT=low

# LLM_STUB=1 replaces the model with a keyword heuristic so you can try the
# whole app (Inngest steps, branching, UI) without a key. Leave unset for real answers.
LLM_STUB=0

# --- Inngest -----------------------------------------------------------------
# Tells the SDK to talk to the local dev server (http://localhost:8288)
# instead of Inngest Cloud. No signing/event keys needed in this mode.
INNGEST_DEV=1
